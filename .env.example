# ==============================================================================
# 🐥 Yellow Duck SMM (منصة البطة الصفرا لخدمات السوشيال ميديا)
# Railway & Production Environment Configuration
# ==============================================================================

# Application & Railway runtime
APP_DEBUG="false"
APP_ENV="production"
APP_KEY="base64:06wHMV8NCtWjZ8aq4aNv26rfjgwC0GRrOrOSHbbzsKM="
APP_URL="https://smm-production-de6d.up.railway.app"
PORT=3000
HOST="0.0.0.0"
NODE_ENV="production"

# Railway MySQL Database Connection (automatically injected by Railway MySQL Service)
DB_DATABASE="${{MySQL.MYSQLDATABASE}}"
DB_HOST="${{MySQL.MYSQLHOST}}"
DB_PASSWORD="${{MySQL.MYSQLPASSWORD}}"
DB_PORT="${{MySQL.MYSQLPORT}}"
DB_USERNAME="${{MySQL.MYSQLUSER}}"

# Logging settings
LOG_CHANNEL="stderr"
LOG_LEVEL="warning"

# Session & Authentication Settings
SESSION_CONNECTION="mysql"
SESSION_COOKIE="yellow_duck_session_v5"
SESSION_DRIVER="database"
SESSION_LIFETIME="480"
SESSION_SECURE_COOKIE="true"

# SMM Provider: SMMFansFaster API & Auto-Sync
SMM_STATUS_SYNC_ENABLED="true"
SMM_STATUS_SYNC_INTERVAL="120"
SMMFANSFASTER_API_KEY="your_smm_provider_api_key_here"
SMMFANSFASTER_API_URL="https://smmfansfaster.com/api/v2"
SMMFANSFASTER_MARGIN_PERCENT="10"
SMMFANSFASTER_PROVIDER_STATUS="active"

# Accounts & Security Hashes
YELLOW_DUCK_ADMIN_PASSWORD_HASH=""
YELLOW_DUCK_RESET_OWNER_ACCOUNTS="false"
YELLOW_DUCK_USER_PASSWORD_HASH=""

# Currency Exchange (USD to EGP)
YELLOW_DUCK_USD_EGP_RATE="55"

# Persistent Volume Storage directory (for JSON snapshot persistence across dyno restarts)
DATA_DIR="./data"

# ==============================================================================
# Google Authentication & Firebase Client Keys (Required for Vite Client)
# Put your real values into your private .env file (DO NOT commit .env to GitHub)
# ==============================================================================
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="1:xxxx:web:xxxx"
VITE_FIREBASE_OAUTH_CLIENT_ID="xxxx.apps.googleusercontent.com"
